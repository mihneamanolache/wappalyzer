{
    "name": "wappalyzer",
    "description": "Identify technology on websites",
    "scripts": {
        "test": "node scripts/run-tests.js && node scripts/smoke-cli.js",
        "test:unit": "node scripts/run-tests.js",
        "test:cli": "node scripts/smoke-cli.js",
        "validate": "node scripts/validate.js",
        "validate:json": "node scripts/validate.js --json",
        "update": "node scripts/merge-update.js",
        "update:dry-run": "node scripts/merge-update.js --dry-run",
        "update:report": "node scripts/merge-update.js --report",
        "normalize": "node scripts/merge-update.js --normalize",
        "coverage": "node scripts/coverage-report.js",
        "delta": "node scripts/catalog-delta.js",
        "delta:check": "node scripts/catalog-delta.js --check",
        "sweep": "node scripts/dns-sweep.js",
        "sweep:check": "node scripts/dns-sweep.js --check",
        "audit:xhr": "node scripts/xhr-audit.js",
        "audit:xhr:check": "node scripts/xhr-audit.js --check",
        "check:whitespace": "node scripts/check-whitespace.js"
    },
    "keywords": [
        "analyze",
        "identify",
        "detect",
        "detector",
        "technology",
        "cms",
        "framework",
        "library",
        "software"
    ],
    "homepage": "https://www.wappalyzer.com/",
    "version": "6.10.69",
    "author": "Wappalyzer",
    "license": "GPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/wappalyzer/wappalyzer"
    },
    "funding": [
        {
            "url": "https://github.com/sponsors/aliasio"
        }
    ],
    "main": "driver.js",
    "files": [
        "cli.js",
        "categories.json",
        "driver.js",
        "index.js",
        "technologies/*",
        "wappalyzer.js",
        "scripts/lib/channels.js",
        "scripts/lib/engine.js",
        "scripts/lib/text-signals.js"
    ],
    "bin": {
        "wappalyzer": "./cli.js"
    },
    "dependencies": {
        "puppeteer": "~25.4.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
