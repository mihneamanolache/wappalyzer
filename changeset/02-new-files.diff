+
+    assert.deepEqual(entry.meta, { generator: 'Example (\\d+)' })
+    assert.equal(entry.dom, undefined)
+})
+
+test('a dom content rule on a meta tag moves to the meta channel', () => {
+    const entry = normalize('Databricks', {
+        cats: [1],
